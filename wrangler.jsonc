{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skazka",
  "compatibility_date": "2026-04-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    // serve 404.html (with a 404 status) for any path that does not exist
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
